# Copie para .env.prod na VM (nunca commite .env.prod)
POSTGRES_DB=subseopro
POSTGRES_USER=subseopro
POSTGRES_PASSWORD=Troque-por-uma-senha-forte

Jwt__Secret=Troque-por-segredo-longo-min-32-caracteres
Jwt__Issuer=SubseOpro
Jwt__Audience=SubseOproApp
Auth__BcryptWorkFactor=12
Seed__RunOnStartup=false

# CORS (opcional): deixe Cors__AllowedOrigins vazio para wildcard
# *.subse-pro.omnora.tech + subse-pro.omnora.tech (Program.cs).
# App mobile nativo não usa CORS.
# Cors__AllowedOrigins__0=https://subse-pro.omnora.tech
